QDialog {
    background-color: #f8fafc;
}

QLabel {
    color: #2f3640;
    font-size: 12px;
}

QTextEdit {
    background: white;
    border: 1px solid #dbe2ea;
    border-radius: 6px;
    padding: 8px;
    /* font-size: 12px; */
}

QTableWidget {
    background: white;
    border: 1px solid #dbe2ea;
    border-radius: 6px;
    gridline-color: #edf2f7;
    font-size: 12px;
    selection-background-color: transparent;
}

QTableWidget::item{
    padding: 6px;
}

QHeaderView::section {
    background-color: #1e293b;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QPushButton {
    background-color: #1e293b;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #334155;
}

#tituloReporte{
    font-size: 24px;
    font-weight: bold;
    color: #1e293b;
    padding-bottom 10px;
}

#empresaLabel{
    font-size: 15px;
    font-weight: bold;
    color: #334155;
    padding-bottom: 10px;
}

#lineaSeparador{
    color: #cbd5e1;
}

#cardResumen{
    background: white;
    border: 1px solid #dbe2ea;
    border-radius: 8px;
}